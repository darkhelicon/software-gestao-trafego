# ========================
# DATABASE
# ========================
DATABASE_URL="postgresql://helzoscale:helzoscale@localhost:5432/helzoscale?schema=public"

# ========================
# REDIS
# ========================
REDIS_URL="redis://localhost:6379"

# ========================
# API
# ========================
NODE_ENV="development"
PORT=3001
API_URL="http://localhost:3001"

# ========================
# FRONTEND
# ========================
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ========================
# FIREBASE ADMIN
# ========================
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ========================
# JWT
# ========================
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ========================
# ENCRYPTION
# ========================
ENCRYPTION_KEY=""   # 32-byte hex para AES-256

# ========================
# STRIPE
# ========================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_START=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_SCALE=""
STRIPE_PRICE_ENTERPRISE=""

# ========================
# TIKTOK
# ========================
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3001/api/v1/oauth/tiktok/callback"

# ========================
# META
# ========================
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3001/api/v1/oauth/meta/callback"

# ========================
# GCP
# ========================
GCP_PROJECT_ID=""
GCP_BUCKET_NAME=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ========================
# SENTRY
# ========================
SENTRY_DSN=""

# ========================
# CORS / FRONTEND
# ========================
ALLOWED_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# ========================
# DEMO / STAGING MODE
# ========================
# Ativa mocks em memória (sem PostgreSQL, Redis, Firebase, Stripe externos).
# Nunca usar em production (NODE_ENV=production bloqueia automaticamente).
# Requer ambos: um para a API, outro para o frontend Next.js.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
