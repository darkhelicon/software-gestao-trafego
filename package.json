{
  "name": "helzo-scale",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:demo": "turbo run build --filter=@helzo-scale/config --filter=@helzo-scale/types --filter=@helzo-scale/integrations --filter=@helzo-scale/database && turbo run dev --filter=@helzo-scale/api --filter=@helzo-scale/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @helzo-scale/database db:generate",
    "db:migrate": "pnpm --filter @helzo-scale/database db:migrate",
    "db:push": "pnpm --filter @helzo-scale/database db:push",
    "db:studio": "pnpm --filter @helzo-scale/database db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "@types/node": "^22.10.2"
  }
}
